# Copy to .env and fill in. Nothing here is required just to try the portal locally.
PORT=3000
# Public https URL once deployed (used in unsubscribe links)
PUBLIC_URL=http://localhost:3000
# Login password for the portal (strongly recommended before exposing it)
PORTAL_PASSWORD=

# --- Lead discovery ---
# Google Cloud console -> enable "Places API (New)" -> create an API key
GOOGLE_PLACES_API_KEY=
# Optional: named contacts + headcount via hunter.io
HUNTER_API_KEY=

# --- Sending (SMTP). Google Workspace: smtp.gmail.com, port 465, an App Password ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Replies (IMAP). Google Workspace: imap.gmail.com, port 993. Defaults to the SMTP user/pass ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- AI drafting (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
