# ---------------------------------------------------------------------------
# HBS Client Portal — environment.
# Copy to .env and fill in. Never commit the filled-in copy.
# ---------------------------------------------------------------------------

# Where the SQLite file lives. Swap for a connection string when this moves to
# Postgres; nothing outside server/src/db reads it.
DATABASE_PATH=./data/portal.db

# Signs session cookies and the email reply-to tokens. REQUIRED in production —
# the server refuses to start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Portfolio Manager ------------------------------------------------------
# Leave ESPM_USERNAME and ESPM_PASSWORD unset to run in fixture mode, where the
# portal replays recorded responses and never touches the network. Set both to
# talk to the real service.
#
# ESPM_ENVIRONMENT=test  → https://portfoliomanager.energystar.gov/wstest
# ESPM_ENVIRONMENT=live  → https://portfoliomanager.energystar.gov/ws
ESPM_MODE=fixture
ESPM_ENVIRONMENT=test
ESPM_USERNAME=
ESPM_PASSWORD=
# Optional: skips one API call on each sync if you already know the account id.
ESPM_ACCOUNT_ID=

# --- Outbound email ---------------------------------------------------------
# Unset means the outbox is written to the database and shown in the UI rather
# than delivered — which is what you want in development.
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=portal@hbssolutions.example
# Replies to addresses at this domain are threaded back into the portal.
MAIL_REPLY_DOMAIN=reply.hbssolutions.example
