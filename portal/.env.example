# ---------------------------------------------------------------------------
# HBS Client Portal — environment.
# Copy to .env and fill in. Never commit the filled-in copy.
# ---------------------------------------------------------------------------

# Where the SQLite file lives. This one file is the entire application state —
# back it up. (Moving to Postgres is not a swap of this line: the SQLite driver
# is synchronous, so every service that touches the database would have to
# become async. See "Where this goes next" in the README.)
DATABASE_PATH=./data/portal.db

# Signs session cookies and the email reply-to tokens. REQUIRED in production —
# the server refuses to start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Encrypts credentials the portal must replay — a tenant's ENERGY STAR
# password. Kept separate from SESSION_SECRET so rotating session signing does
# not make every stored credential undecryptable. REQUIRED in production.
CREDENTIAL_KEY=

PORT=4000

# Only needed when the browser app is served from a *different* origin than the
# API — that is the development setup (Vite on :5173). A deployment serves the
# built app from this same process, so leave this unset in production and no
# cross-origin access is granted at all.
WEB_ORIGIN=http://localhost:5173

# The origin customers reach the portal on. Invitation links are built from it,
# so a wrong value sends people a link that cannot work. REQUIRED in production —
# the server refuses to start without it.
PUBLIC_ORIGIN=http://localhost:5173

# How many reverse-proxy hops sit in front of the app (1 for a single load
# balancer). Off by default: trusting X-Forwarded-For that nobody set lets a
# caller spoof their address past the rate limiter. Set it when deploying
# behind a proxy, or every request looks like it came from the proxy.
TRUST_PROXY=

# Where the built browser app lives. The container sets this itself.
WEB_DIST_PATH=

# --- Portfolio Manager ------------------------------------------------------
# Leave ESPM_USERNAME and ESPM_PASSWORD unset to run in fixture mode, where the
# portal replays recorded responses and never touches the network. Set both to
# talk to the real service.
#
# ESPM_ENVIRONMENT=test  → https://portfoliomanager.energystar.gov/wstest
# ESPM_ENVIRONMENT=live  → https://portfoliomanager.energystar.gov/ws
ESPM_MODE=fixture
ESPM_ENVIRONMENT=test
ESPM_USERNAME=
ESPM_PASSWORD=
# Optional: skips one API call on each sync if you already know the account id.
ESPM_ACCOUNT_ID=

# --- Outbound email ---------------------------------------------------------
# Unset means the outbox is written to the database and shown in the UI rather
# than delivered — which is what you want in development.
# Set SMTP_HOST to start delivering. Until then the portal still records every
# invitation and notification in the outbox, and an admin can copy an
# invitation link out of the UI by hand — nothing is lost, it just is not
# emailed. Port 465 is used as implicit TLS; anything else upgrades with
# STARTTLS. User and password are optional for a relay that does not need them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=portal@hbssolutions.example
# Replies to addresses at this domain are threaded back into the portal.
MAIL_REPLY_DOMAIN=reply.hbssolutions.example
