# monday.com — personal API token (Admin > API, or your avatar > Developers)
MONDAY_API_KEY=

# Microsoft Graph / SharePoint, for writing the workbook back
# device-code auth needs TENANT + CLIENT; client-credentials also needs SECRET
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Optional: override the config file location
# HBS_SCOREBOARD_CONFIG=config/scoreboard.yml
