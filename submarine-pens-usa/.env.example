# Copy this file to .env and fill in your values. Never commit .env.

# From https://developer.squareup.com/apps -> your app -> Credentials
# Use the Sandbox token + Sandbox location while testing.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# sandbox | production
SQUARE_ENVIRONMENT=sandbox

# Public address of the site (used for the "back to store" redirect after payment)
SITE_URL=http://localhost:3000
PORT=3000

# Shipping in cents. 599 = $5.99. Free shipping at or above FREE_SHIPPING_OVER_CENTS (0 = never free).
SHIPPING_FLAT_CENTS=599
FREE_SHIPPING_OVER_CENTS=5000
