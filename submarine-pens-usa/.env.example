# Copy this file to .env and fill in your values. Never commit .env.

# --- Square (payments) ---
# From https://developer.squareup.com/apps -> your app -> Credentials / Locations.
# Leave blank to run in demo mode (no payment taken).
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# sandbox | production
SQUARE_ENVIRONMENT=sandbox

# Public address of the site (used for the redirect after payment and in the sitemap)
SITE_URL=http://localhost:3000
PORT=3000

# --- Contact form email (optional) ---
# Messages are always saved to data/messages.jsonl. To also get them by email,
# create a free Resend account (resend.com), verify your domain, and fill these in.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
