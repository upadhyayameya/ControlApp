# Public site URL (used for canonical URLs, sitemap, RSS, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://wattonearth.in

# Formspree form ID (the part after https://formspree.io/f/). Used by contact,
# newsletter and Energy & Carbon Check lead capture.
NEXT_PUBLIC_FORMSPREE_ID=

# Optional: show draft news posts on a preview deployment. NEVER set on production.
# SHOW_DRAFTS=true

# News drafting script (scripts/fetch-news.ts) — set as GitHub Actions secrets/vars.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
